#!/usr/bin/make -f

%:
	dh $@ --with python3 --buildsystem=cmake

override_dh_auto_install:
	mkdir -p debian/linkamp/usr/bin
	cp build/player debian/linkamp/usr/bin/linkamp-player

	mkdir -p debian/linkamp/usr/lib/python3/dist-packages/linamp
	cp -r python/linamp debian/linkamp/usr/lib/python3/dist-packages/
	
	mkdir -p debian/linkamp/usr/share/applications/
	cp linkamp.desktop debian/linkamp/usr/share/applications/
	
	mkdir -p debian/linkamp/usr/share/icons/hicolor/72x72/apps/
	cp assets/linkamp-icon-72.png debian/linkamp/usr/share/icons/hicolor/72x72/apps/linkamp-player.png
