{
  "manifest_version": 3,
  "name": "Aggiungi a Linkamp",
  "version": "1.0.8",
  "description": "Aggiunge video YouTube a Linkamp e rileva file skin .wsz sui siti web.",
  "browser_specific_settings": {
    "gecko": {
      "id": "linkamp-youtube@stefanobasile",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["autoplay-guard.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["skin-content.js"],
      "run_at": "document_idle"
    }
  ]
}
